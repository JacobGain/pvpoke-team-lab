{
  "name": "team-lab",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender-public.ts dist && node --experimental-strip-types scripts/validate-build-capabilities.ts dist diagnostics-disabled && npm run validate:cloudflare",
    "build:admin": "tsc -b && vite build --mode admin && node --experimental-strip-types scripts/validate-build-capabilities.ts dist-admin diagnostics-enabled",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:admin": "vite preview --mode admin",
    "sync:pvpoke": "node --experimental-strip-types scripts/sync-pvpoke-assets.ts",
    "sync:sprites": "node --experimental-strip-types scripts/sync-pokemon-sprites.ts",
    "test": "vitest run --exclude src/performance/mvpScale.characterization.test.ts",
    "test:browser": "node --experimental-strip-types scripts/browser-workflows.ts",
    "test:deployment": "node --experimental-strip-types scripts/browser-workflows.ts --production --deployment",
    "test:production": "npm run build && npm run test:production:artifact",
    "test:production:artifact": "node --experimental-strip-types scripts/browser-workflows.ts --production",
    "test:visual": "node --experimental-strip-types scripts/browser-workflows.ts --visual=verify",
    "test:scale": "vitest run src/performance/mvpScale.characterization.test.ts --reporter=verbose --maxWorkers=1 --disableConsoleIntercept",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "update:visual": "node --experimental-strip-types scripts/browser-workflows.ts --visual=update",
    "validate:cloudflare": "node --experimental-strip-types scripts/validate-cloudflare-artifact.ts dist",
    "validate:data": "node --experimental-strip-types scripts/validate-pvpoke-data.ts",
    "validate:workflows": "node --experimental-strip-types scripts/validate-workflow-security.ts",
    "wait:deployment": "node --experimental-strip-types scripts/wait-for-deployment.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.102.8",
    "dexie": "4.4.5",
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router": "8.3.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "6.2.5",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}

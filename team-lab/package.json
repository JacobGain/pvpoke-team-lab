{
  "name": "team-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:pvpoke": "node --experimental-strip-types scripts/sync-pvpoke-assets.ts",
    "sync:sprites": "node --experimental-strip-types scripts/sync-pokemon-sprites.ts",
    "test": "vitest run",
    "test:browser": "node --experimental-strip-types scripts/browser-workflows.ts",
    "test:visual": "node --experimental-strip-types scripts/browser-workflows.ts --visual=verify",
    "test:scale": "vitest run src/performance/mvpScale.characterization.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "update:visual": "node --experimental-strip-types scripts/browser-workflows.ts --visual=update",
    "validate:data": "node --experimental-strip-types scripts/validate-pvpoke-data.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.4",
    "dexie": "4.4.4",
    "lucide-react": "^1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
